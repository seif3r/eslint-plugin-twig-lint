{
  "name": "twig-code-formatter-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w twig-code-formatter",
    "typecheck": "tsc -p packages/core --noEmit",
    "test": "npm test -w twig-code-formatter",
    "golden": "node test/run.mjs --cmd 'node packages/core/src/cli.ts lint --fix --quiet {file}'"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
