{
  "name": "eslint-plugin-twig-lint",
  "version": "0.1.0",
  "description": "ESLint plugin that lints and formats Twig templates: indentation, line wrapping and spacing.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "twig",
    "drupal",
    "formatter",
    "lint"
  ],
  "license": "MIT",
  "author": "Anders Niemi Brundin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seif3r/twig-code-formatter.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "eslint": ">=9.15.0"
  },
  "dependencies": {
    "@eslint/plugin-kit": "^0.7.3"
  },
  "devDependencies": {
    "@eslint/core": "^1.2.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "typescript": "^5.8.0"
  }
}
